# User uploads: serve as static files only, never execute.
Options -Indexes -ExecCGI
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phps .cgi .pl .py .jsp .asp .sh
RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .phps
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<FilesMatch "\.(?i:php\d?|phtml|phps|phar|cgi|pl|py|jsp|asp|aspx|sh|htaccess)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
AddType text/plain .php .phtml .phps
